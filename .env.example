# Copy this file to .env style settings in your host dashboard.

# Password the teacher types on the login page.
ADMIN_PASSWORD=admin123

# Any long random string. Keeps the login cookie signed.
SESSION_SECRET=change-this-to-something-random

# Only needed if you want the QR codes to point somewhere other than the address
# the browser is using, e.g. your laptop IP while testing on the same wifi.
# BASE_URL=http://192.168.1.5:3000

# Only needed if the database should live somewhere else, e.g. a mounted disk.
# DB_PATH=/data/attendance.db
